---
// One page serves every /members/<handle>: Vercel rewrites the address to it, and the page reads
// the handle from the address. Profiles are made by members, so the page itself stays out of search.
import { itemMetadata } from '../../data/metadata';
import { seedPage } from '../../data/page';
import Base from '../../layouts/base.astro';
import { PublicProfilePage } from '../../views/public-profile-page';
---

<Base
  {...itemMetadata('NODE member', 'A member of the Northern Ontario Dev Exchange.')}
  content={seedPage({})}
  noindex
>
  <PublicProfilePage client:load />
</Base>
