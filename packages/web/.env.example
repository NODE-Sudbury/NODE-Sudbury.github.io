# Sign-in and member accounts use Supabase. Vite reads the file for the mode it runs in:
#   .env.development  for `npm start` (the Node Website Dev project)
#   .env.production   for `npm run build` (the Node Website project)
# The names match the Vercel project's, so a build there needs no new settings.
# Both values are public: they ship to the browser. Row level security protects the data.
# Find them in the Supabase dashboard under Project Settings, API, or with
# `supabase projects api-keys --project-ref <ref>`. Never put the service role key here.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<the anon (public) key>

# Google's public client id, for the Google sign-in button on the site's own page (so Google names
# nodesudbury.com, not the Supabase address). It is the same client that Supabase's Google sign-in
# uses, and it is public. Leave it out and sign-in with Google goes through Supabase's redirect.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=<the client id ending in .apps.googleusercontent.com>
