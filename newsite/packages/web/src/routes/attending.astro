---
import { pageMetadata } from '../data/metadata';
import { seedPage } from '../data/page';
import Base from '../layouts/base.astro';
import { AttendingPage } from '../views/attending-page';

const content = seedPage({});
---

<Base
  {...pageMetadata('attending')}
  content={content}
  breadcrumbs={[{ name: 'Attending', path: '/attending' }]}
>
  <AttendingPage client:load />
</Base>
