---
import { posts } from 'virtual:node-site/markdown';
import { site } from 'virtual:node-site/site';
import { loadContent } from '../../data/content';
import { itemMetadata } from '../../data/metadata';
import { seedPage } from '../../data/page';
import { withPostSource } from '../../data/posts';
import { absoluteUrl, postStructuredData } from '../../data/structured-data';
import type { Post } from '../../models/post';
import Base from '../../layouts/base.astro';
import { PostPage } from '../../views/post-page';

export const getStaticPaths = async () => {
  const { blog = [] } = await loadContent();
  return blog.map((post) => ({ params: { id: post.id }, props: { post } }));
};

const { post } = Astro.props as { post: Post };
const { blog = [] } = await loadContent();
const content = seedPage({
  blog: blog.map((item) => (item.id === post.id ? withPostSource(item, posts) : item)),
});
const pageUrl = absoluteUrl(`/blog/${post.id}`, site.url);
const image = post.image ? absoluteUrl(post.image, site.url) : undefined;
---

<Base
  {...itemMetadata(post.title, post.brief, image)}
  content={content}
  ogType="article"
  breadcrumbs={[
    { name: 'Blog', path: '/blog' },
    { name: post.title, path: `/blog/${post.id}` },
  ]}
  jsonLd={[
    postStructuredData(post, {
      pageUrl,
      ...(image ? { image } : {}),
      organization: `${site.url}#organization`,
    }),
  ]}
>
  <PostPage postId={post.id} client:load />
</Base>
