# Sign-in and member accounts use Supabase. Vite reads the file for the mode it runs in:
#   .env.development  for `npm start` (the Node Website Dev project)
#   .env.production   for `npm run build` (the Node Website project)
# Both values are public: they ship to the browser. Row level security protects the data.
# Find them in the Supabase dashboard under Project Settings, API, or with
# `supabase projects api-keys --project-ref <ref>`. Never put the service role key here.
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
PUBLIC_SUPABASE_ANON_KEY=<the anon (public) key>
