{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "FIRESTORE_TARGET=sample SYNC_GITHUB=1 SYNC_EVENTS=1 npm run build",
  "outputDirectory": "packages/web/dist",
  "cleanUrls": true,
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ] || [ \"$VERCEL_GIT_COMMIT_REF\" = \"dev\" ]; then exit 1; else exit 0; fi",
  "redirects": [{ "source": "/schedule", "destination": "/events", "permanent": true }],
  "rewrites": [{ "source": "/members/:handle", "destination": "/members" }],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/service-worker.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
