# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Resend - email (required for automated emails)
RESEND_API_KEY=re_...

# Supabase DB direct connection - Canada Central pooler
# Used for running migrations locally via psql
# SUPABASE_DEV_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ca-central-1.pooler.supabase.com:5432/postgres
# SUPABASE_PROD_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ca-central-1.pooler.supabase.com:5432/postgres
